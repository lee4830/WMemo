<Window x:Class="WMemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        Title="윈도우 메모" Width="1440" Height="820" MinWidth="1200" MinHeight="680"
        Icon="Assets/note.ico"
        FontFamily="Malgun Gothic" FontSize="13"
        Background="#EEF2F6"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F3F7FB"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" ToolTip="제목과 본문에서 검색" Tag="제목/본문 검색"/>
                        <TextBlock x:Name="SearchHintText"
                                   Text="제목/본문 검색"
                                   Foreground="#94A3B8"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="ClearSearchButton" Grid.Column="1" Content="X" FontWeight="Bold" Margin="4,0,0,0"/>
                </Grid>
                <ComboBox x:Name="SortCombo" Grid.Row="1" Margin="0,6,0,0"/>
                <ComboBox x:Name="CategoryFilterCombo" Grid.Row="2" Margin="0,6,0,0"/>
                <ListBox x:Name="MemoList" Grid.Row="3" Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CountText" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SoftSurfaceBrush}" CornerRadius="6" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NewButton" Content="새 메모" Width="84" Margin="0,0,6,0"/>
                        <Button x:Name="SaveButton" Content="저장" Width="70" Margin="0,0,6,0" Background="#DBEAFE" BorderBrush="#93C5FD"/>
                        <Button x:Name="DeleteButton" Content="삭제" Width="70" Margin="0,0,6,0"/>
                        <Button x:Name="InfoButton" Content="정보" Width="70" Margin="0,0,6,0"/>
                        <Button x:Name="BackupButton" Content="백업" Width="70" Margin="0,0,6,0"/>
                        <Button x:Name="SettingsButton" Content="설정" Width="70"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="MetaText" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="등록: -    수정: -"/>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryCombo" Grid.Column="0" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="|" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="TitleBox"
                                 Grid.Column="2"
                                 Height="36"
                                 MinHeight="36"
                                 Padding="9,0"
                                 VerticalContentAlignment="Center"
                                 FontWeight="SemiBold"
                                 FontSize="15"
                                 Background="#FFFFFF"/>
                        <TextBlock Grid.Column="2" Margin="11,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" Text="제목을 입력하세요">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=TitleBox}" Value=""/>
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TitleBox}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource SoftSurfaceBrush}" CornerRadius="6" Padding="8,7" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BoldButton" Content="B" Width="34" FontWeight="Bold" Margin="0,0,4,0"/>
                        <Button x:Name="ItalicButton" Content="I" Width="34" FontStyle="Italic" Margin="0,0,4,0"/>
                        <Button x:Name="UnderlineButton" Content="U" Width="34" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FontCombo" Width="170" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SizeCombo" Width="70" Margin="0,0,6,0"/>
                        <Button x:Name="TextColorButton" Content="글자색" Width="70" Margin="0,0,6,0"/>
                        <Button x:Name="HighlightButton" Content="강조" Width="58"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="#FFFFFF"
                        BorderBrush="#94A3B8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,10,0,0"
                        Padding="10">
                    <RichTextBox x:Name="BodyBox"
                                 BorderThickness="0"
                                 Padding="10"
                                 AcceptsTab="False"
                                 SpellCheck.IsEnabled="False"
                                 input:InputMethod.IsInputMethodEnabled="True"
                                 VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
